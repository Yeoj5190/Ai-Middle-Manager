# ── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Leave these BLANK to run in dev-fallback mode (UI renders from seed data, auth
# bypassed). Fill them in to run against real Postgres with auth + RLS.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, NEVER expose to the browser. Used by the seed
# script (scripts/seed.mjs) to bypass RLS while loading demo data.
SUPABASE_SERVICE_ROLE_KEY=

# The demo org every new signup is attached to (created by the seed). Keep in
# sync with supabase/seed.sql.
NEXT_PUBLIC_DEMO_ORG_ID=00000000-0000-0000-0000-000000000001
